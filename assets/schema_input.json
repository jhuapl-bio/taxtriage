{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/jhuapl-bio/taxtriage/master/assets/schema_input.json",
    "title": "jhuapl-bio/taxtriage pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "fastq_1": {
                "type": "string",
                "pattern": "^(?:\\S+\\.f(ast)?q\\.gz|(SRR|ERR|DRR|SRX|ERX|DRX|SRS|ERS|DRS|SRP|ERP|DRP)[0-9]{5,}|SAM(N|EA|EG|D)[0-9]+|PRJ(NA|EB|EA|DA|DB)[0-9]+)$",
                "errorMessage": "fastq_1 must be either a gzipped FastQ path (extension '.fq.gz' or '.fastq.gz', no spaces) or an SRA/ENA accession (SRR/ERR/DRR, SRX/ERX/DRX, SRS/ERS/DRS, SAMN/SAMEA, SRP/ERP/DRP, PRJNA/PRJEB) to download automatically"
            },
            "fastq_2": {
                "errorMessage": "FastQ file for reads 2 cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^\\S+\\.f(ast)?q\\.gz$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "bam": {
                "errorMessage": "Pre-aligned file must have extension '.bam', '.cram' or '.sam' and cannot contain spaces. When set, fastq_1/fastq_2 are ignored and the sample skips QC, classification and reference downloading.",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^\\S+\\.(bam|cram|sam)$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "fasta": {
                "errorMessage": "Per-sample alignment reference: one FASTA (.fa/.fasta/.fna, .gz ok), no spaces. Replaces --reference_fasta for this row.",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^\\S+\\.(fa|fasta|fna|fas|fsa)(\\.gz)?$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "mask_fasta": {
                "errorMessage": "Per-sample masked FASTA(s) (';'-separated, .gz ok): masked bases are not scored for this row.",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^\\S+\\.(fa|fasta|fna|fas|fsa)(\\.gz)?(;\\S+\\.(fa|fasta|fna|fas|fsa)(\\.gz)?)*$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "mask_bed": {
                "errorMessage": "Per-sample BED(s) (';'-separated): regions to ignore (exclude) or score (target) for this row.",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^\\S+\\.bed(\\.gz)?(;\\S+\\.bed(\\.gz)?)*$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "mask_mode": {
                "errorMessage": "mask_mode must be 'exclude' or 'target'",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^(?i:exclude|target)$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "mask_fasta_case": {
                "errorMessage": "mask_fasta_case must be hard, soft or both",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^(?i:hard|soft|both)$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "mask_penalty_power": {
                "errorMessage": "mask_penalty_power must be a number >= 0",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^[0-9]*\\.?[0-9]+$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            }
        },
        "anyOf": [
            {
                "required": ["sample", "fastq_1"]
            },
            {
                "required": ["sample", "bam"]
            }
        ],
        "required": ["sample"]
    }
}
