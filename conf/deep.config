/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    jhuapl-bio/taxtriage — deep sequencing profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    For multi-GB FASTQ inputs (deep WGS / high-output NovaSeq / PromethION runs) on a
    large workstation or HPC node.  Turns on BBMap bbnorm read reduction by default so
    the classifier and aligner stages stay tractable, and raises the memory/time
    ceilings for the stages that actually scale with input size.

    Use as follows:
        nextflow run https://github.com/jhuapl-bio/taxtriage -latest -profile deep,docker -r main \
            --input samplesheet.csv --outdir results

    READ REDUCTION, in pipeline order:
      1. bbnorm (--downsample, ON here)  — k-mer coverage normalisation, ILLUMINA ONLY.
         Runs after trimming, before host removal.  Flattens the high-abundance
         background (host carry-over, dominant commensals) while leaving rare organisms
         intact, which is exactly what you want before triage.
      2. seqtk (--subsample, ON here)    — blunt random read cap, ALL platforms.
         Runs after host removal.  This is the only reduction ONT/PacBio gets, since
         bbnorm's k-mer table is meaningless on noisy long reads.

    CAVEAT: bbnorm deliberately destroys relative abundance.  If a downstream
    interpretation depends on read-proportion abundance rather than presence/absence
    plus coverage, run with --downsample false and rely on --subsample alone.

    Knobs you will most likely override on the CLI:
        --bbnorm_target 50        // normalise harder (default 100)
        --bbnorm_mindepth 1       // keep singleton-depth reads (most sensitive)
        --subsample 100000000     // raise/lower the post-host-removal cap
        --subsample null          // no hard cap
        --downsample false        // no bbnorm at all
        --db pluspfp              // bigger classifier DB
----------------------------------------------------------------------------------------
*/

aws.client.anonymous = false

params {
    // Gate for conf/deep_process.config -- see the note at the top of that file.
    deep_profile = true

    config_profile_name        = 'Deep sequencing profile'
    config_profile_description = 'High-depth (multi-GB FASTQ) runs on a large workstation or HPC node'

    // ── Resource ceilings ────────────────────────────────────────────────────
    // base.config reads max_cpus/max_memory/max_time for its resourceLimits.
    max_cpus   = 32
    max_memory = '256.GB'
    max_time   = '72.h'
    resourceLimits = [
        cpus  : 32,
        memory: 256.GB,
        time  : 72.h
    ]

    // ── Read reduction: BBMap bbnorm (the point of this profile) ─────────────
    downsample       = true
    bbnorm_target    = 100    // normalise to ~100x k-mer coverage
    bbnorm_mindepth  = 2      // NOT bbnorm's default of 6 -- that would delete
                              // low-abundance organisms, i.e. the ones we care about
    bbnorm_passes    = 2
    bbnorm_prefilter = true   // essential at multi-GB scale: bloom prefilter keeps the
                              // k-mer table from exploding on error k-mers
    bbnorm_args      = null

    // Hard cap after host removal. Applies to every platform, so this is what
    // bounds an ONT/PacBio deep run. Set null for true full depth.
    subsample = 100000000

    // ── Classification ───────────────────────────────────────────────────────
    classifiers           = 'kraken2'
    db                    = 'standard'
    download_db           = true
    default_download      = true
    download_taxdump      = true
    low_memory            = false   // load the k2 DB into RAM; we have the headroom
    k2_minimum_hit_groups = 3
    min_conf              = 0.1     // trims deep-run false positives from spurious k-mers

    // ── Host / commensal handling ────────────────────────────────────────────
    genome           = 'GRCh38'
    remove_taxids    = "9606"
    remove_commensal = true
    demux            = true
    ignore_missing   = true

    // ── Alignment ────────────────────────────────────────────────────────────
    // Deep runs pull many top hits, so the concatenated reference can exceed
    // minimap2's single-index budget. split_prefix indexes it in blocks instead.
    split_prefix    = true
    mmap2_I         = '8G'    // index block size
    mmap2_K         = '2G'    // minibatch of query bases per thread batch
    minmapq         = 4
    min_reads_align = 5       // higher floor: deep data makes 1-2 read "hits" noise

    // ── Reporting ────────────────────────────────────────────────────────────
    top_hits_count    = 50
    top_per_taxa      = '10239:20:S 2:20:S'
    taxtab            = 'default'
    annotate          = true
    compress_species  = false
    skip_plots        = false
    skip_fastp        = true
    skip_denovo       = true    // de novo assembly on multi-GB input rarely pays its wall time
    skip_refpull      = false
    sensitive         = false   // deep coverage already finds what sensitive mode digs for
    disable_gene      = false
    outdir            = 'tt_deep_output'

    remove_reference_file = null
    reference_fasta       = null
}
