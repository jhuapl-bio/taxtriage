/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline on a local compute like HPC.

    Use as follows:
        nextflow run https://github.com/jhuapl-bio/taxtriage -r main -latest -profile local,docker

----------------------------------------------------------------------------------------
*/
aws.client.anonymous = true

params {
    config_profile_name        = 'Local Run profile'
    config_profile_description = 'Default configurations for a local workstation or HPC cluster'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 4
    max_time   = '12.h'
    resourceLimits = [
        cpus: 4,
        memory: 100.GB,
        time: 24.h
    ]


    // Input data
    // TODO nf-core: Specify the paths to your test data on nf-core/test-datasets
    // TODO nf-core: Give any required params for the test so that command line flags are not needed
    input  = 'https://raw.githubusercontent.com/jhuapl-bio/taxtriage/main/examples/Samplesheet.csv'

    // Genome references
    download_db = true
    remove_taxids = "9606"
    outdir = 'default_taxtriage_out'
    top_hits_count = 40
    top_per_taxa = '10239:10:S 2:10:S'
    minmapq = 4
    ignore_missing = true
    download_db = true
    low_memory = false
    db = 'standard'
    annotate = true
    compress_species = false
    remove_reference_file = null
    disable_gene = false

}
