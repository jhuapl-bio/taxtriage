/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TaxTriage "lite" profile: MCE-style detection settings on the Kraken2 standard DB,
    TASS + final report only. For a high-end desktop or an HPC node.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Kraken2 (standard) picks the references -> NCBI assemblies downloaded -> minimap2
    -> TASS (match_paths.py) -> per-sample + merged PDF/XLSX + interactive HTML report.

    No reference FASTA, no host removal, no read QC/trimming, no MultiQC, Krona,
    de novo, DIAMOND, annotation, novelty, masking or simulation. The step-skipping
    switches come from conf/light.config (included below), so the two stay in sync.

    Use as follows:
        nextflow run jhuapl-bio/taxtriage -profile lite,docker --input samplesheet.csv --outdir results
        nextflow run jhuapl-bio/taxtriage -profile lite,singularity,slurm --input ... --outdir ...

    Memory: the standard DB is ~80 GB and is loaded into RAM (low_memory = false).
    KRAKEN2_KRAKEN2 asks for 90 GB, capped to the 128 GB limit below. On a machine
    with less RAM than the DB add `--low_memory true` (reads the DB from disk; slower)
    or lower the cap, e.g. `--resourceLimits "[cpus: 16, memory: 64.GB, time: 48.h]"`.

    Database: `db = 'standard'` + `download_db = true` downloads ~78 GB on first run.
    If you already have it, pass `--db /path/to/k2_standard` to use the local copy.

    Air-gapped: also pass --taxdump <dir> and --assembly <assembly_summary_refseq.txt>.
    Images for this profile: python3 scripts/image_manifest.py --mode lite
----------------------------------------------------------------------------------------
*/

// Everything off except samplesheet -> classify -> align -> TASS -> report
includeConfig 'light.config'

process {
    resourceLimits = [
        cpus: 16,
        memory: 128.GB,
        time: 48.h
    ]
}

params {
    config_profile_name        = 'Lite profile'
    config_profile_description = 'MCE detection settings on Kraken2 standard: classify -> minimap2 -> TASS -> report'

    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '48.h'
    resourceLimits = [ time: '48.h', cpus: 16, memory: '128.GB' ]

    // ── Classification: Kraken2 standard DB ─────────────────────────────────
    classifiers           = 'kraken2'
    db                    = 'standard'
    download_db           = true
    low_memory            = false
    k2_minimum_hit_groups = 3
    remove_taxids         = "9606"     // drop human from top hits (no host-removal step)
    remove_commensal      = true
    top_hits_count        = 20
    top_per_taxa          = '10239:10:S 2:10:S'   // viruses + bacteria: top 10 species each
    compress_species      = false

    // ── References: Kraken2 top hits only, downloaded from NCBI ─────────────
    reference_fasta       = null
    get_pathogens         = null
    ignore_missing        = true

    // ── No upfront QC / pre-processing ──────────────────────────────────────
    genome                = null       // no host removal
    remove_reference_file = null
    use_deacon            = false
    skip_trimming         = true
    enable_fastp          = false
    enable_plots          = false
    downsample            = false
    subsample             = null

    // ── Alignment: minimap2 ─────────────────────────────────────────────────
    use_bt2               = false
    use_hisat2            = false
    minmapq               = 4

    // ── TASS + report ───────────────────────────────────────────────────────
    min_reads_align       = 3
    min_conf              = 0.4
}
