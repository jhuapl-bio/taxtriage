/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Named host targets for de-hosting
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    These entries extend the same `params.genomes` map that conf/igenomes.config
    populates, so they are selected with the existing --genome flag:

        --genome mosquito-any

    Unlike the iGenomes entries, they carry no `fasta` path.  Instead they carry:

        accessions  space-separated RefSeq assembly accessions.  HOST_REMOVAL
                    fetches each one from NCBI at runtime (FETCH_HOST_REFS) and
                    concatenates them into a single reference for minimap2.
                    Downloads are cached in --host_reference_dir, so a second run
                    with the same target does not re-download.
        taxids      space-separated taxids for the same organisms.  These are
                    merged into --remove_taxids (dropped from the classification
                    report) and --report_flag_exclude_taxids (never counted as a
                    detection), so any host read that survives alignment is still
                    kept out of the results.
        description free text, shown when the target is selected.

    The "-any" targets are unions, spelled out explicitly so a single --genome
    value covers a whole vector group.

    NOTE: taxid/accession pairs below are as supplied by the pipeline maintainers;
    edit here to add a new host rather than hard-coding a FASTA in a run config.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    genomes {
        'human' {
            description = 'Homo sapiens'
            taxids      = '9606'
            accessions  = 'GCF_000001405.40'
        }
        'aedes' {
            description = 'Aedes mosquitoes (Ae. aegypti + Ae. albopictus)'
            taxids      = '7159 7160'
            accessions  = 'GCF_002204515.2 GCF_035046485.1'
        }
        'anopheles' {
            description = 'Anopheles mosquitoes (An. gambiae)'
            taxids      = '7165'
            accessions  = 'GCF_943734735.2'
        }
        'culex' {
            description = 'Culex mosquitoes (Cx. quinquefasciatus)'
            taxids      = '7176'
            accessions  = 'GCF_015732765.1'
        }
        'mosquito-any' {
            description = 'Any mosquito vector (Aedes + Anopheles + Culex)'
            taxids      = '7159 7160 7165 7176'
            accessions  = 'GCF_002204515.2 GCF_035046485.1 GCF_943734735.2 GCF_015732765.1'
        }
        'ixodes' {
            description = 'Ixodes ticks (I. scapularis)'
            taxids      = '6945'
            accessions  = 'GCF_016920785.2'
        }
        'tick-any' {
            description = 'Any tick vector (Ixodes scapularis)'
            taxids      = '6945'
            accessions  = 'GCF_016920785.2'
        }
    }
}
