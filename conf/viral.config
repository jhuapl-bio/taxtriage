/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline on a compute that needs to only detect basic viral reads.

    Use as follows:
        nextflow run https://github.com/jhuapl-bio/taxtriage -latest -profile viral,docker  -r main

----------------------------------------------------------------------------------------
*/
process {
    resourceLimits = [
        cpus: 4,
        memory: 8.GB,
        time: 20.h
    ]
}
params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    resourceLimits = [ time: '20.h', cpus: 4, memory: '8GB' ]

    // Input data
    // TODO nf-core: Specify the paths to your test data on nf-core/test-datasets
    // TODO nf-core: Give any required params for the test so that command line flags are not needed
    input  = 'https://raw.githubusercontent.com/jhuapl-bio/taxtriage/main/examples/Samplesheet.csv'

    // Genome references
    skip_plots = false
    download_db = true
    ignore_missing = true
    remove_taxids = "9606"
    demux = true
    remove_commensal = true
    classifiers = 'kraken2'
    outdir = 'tt_output'
    top_hits_count = 10
    minmapq = 5
    taxtab = 'default'
    show_commensals = false
    show_potentials = true
    show_unidentified = false
    default_download = true
    db = 'viral'
    top_per_taxa = '10239:10:S 2:10:S'
    k2_minimum_hit_groups = 3
    remove_reference_file = null
    reference_fasta = null
    low_memory = false
    min_conf = null
    annotate = false
    compress_species = false
    min_reads_align = 1
    sensitive = true
    disable_gene = false
    // NOTE: 'test' has no matching alias in kraken2_downloaddb.nf (unlike kaiju_downloaddb.nf,
    // which carries a dedicated tiny 'test' fixture for CI parity) -- it will hard-fail with
    // "unknown kraken2/bracken db name 'test'" if --novelty bracken is ever enabled against this
    // profile. Use the smallest real alias instead until a matching test fixture exists.
    novelty_db = 'viral'
}
