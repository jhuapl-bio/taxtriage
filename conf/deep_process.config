/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    jhuapl-bio/taxtriage — deep sequencing profile: PROCESS RESOURCE OVERRIDES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Do NOT put these in conf/deep.config.  nextflow.config includes conf/modules.config
    AFTER the profiles{} block, so a `withName:` directive set inside a profile is
    silently overwritten by the one in modules.config.  This file is included after
    modules.config, gated on params.deep_profile (which conf/deep.config sets), so its
    directives are the last word.

    Loaded automatically by `-profile deep`.  Nothing else should set deep_profile.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus  : 32,
        memory: 256.GB,
        time  : 72.h
    ]

    maxRetries = 2

    // bbnorm is a JVM tool; the module hands it -Xmx at 95% of task.memory, and the
    // k-mer table is the entire cost. Multi-GB input with prefilter=t wants ~64 GB+.
    // The ladder is 96 -> 192 GB so a retry after an OOM (137) actually has a chance.
    withName: BBMAP_BBNORM {
        cpus   = 16
        memory = { 96.GB * Math.pow(2, task.attempt - 1) }
        time   = { 16.h * task.attempt }
        maxForks   = 1
        maxRetries = 2
        // Retry an OOM/kill, but never end the run over one sample: a thin or empty
        // input (e.g. everything removed by de-hosting) should be skipped, not fatal.
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'ignore' }
    }

    withName: FASTP {
        cpus   = { 12 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: 'TRIMGALORE' {
        cpus   = { 12 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }

    withName: SEQTK_SAMPLE {
        // seqtk streams, but a 100M-read reservoir over multi-GB gzip is not "low".
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: KRAKEN2_KRAKEN2 {
        cpus       = 16
        memory     = { 120.GB * Math.pow(2, task.attempt - 1) }  // 120 -> 240 GB
        time       = { 16.h * task.attempt }
        maxForks   = 1   // one in-RAM DB at a time
        maxRetries = 2
        errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    }

    withName: 'MINIMAP2_ALIGN' {
        cpus       = 16
        // Wider ladder than base.config: 64 -> 96 -> 128 -> 160 GB.
        memory     = { 64.GB + (32.GB * (task.attempt - 1)) }
        time       = { 24.h * task.attempt }
        maxForks   = 2
        maxRetries = 3
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
    }

    withName: 'BOWTIE2_BUILD' {
        cpus   = 16
        memory = { 96.GB * Math.pow(2, task.attempt - 1) }
        time   = { 24.h * task.attempt }
    }

    withName: '.*SAMTOOLS_SORT.*' {
        cpus   = 8
        memory = { 48.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: 'NANOPLOT|FASTQC' {
        memory        = { 32.GB * Math.pow(2, task.attempt - 1) }
        time          = { 8.h * task.attempt }
        errorStrategy = 'ignore'
    }

    withName: PORECHOP {
        cpus   = 12
        memory = { 64.GB * Math.pow(2, task.attempt - 1) }
        time   = { 24.h * task.attempt }
    }

    withName: COUNT_READS {
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 16 * task.attempt }
        memory = { 120.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: process_higher {
        cpus   = { 20 * task.attempt }
        memory = { 180.GB * task.attempt }
        time   = { 36.h * task.attempt }
    }
    withLabel: process_dynamic {
        memory = { 80.GB * Math.pow(2, task.attempt - 1) }
        time   = { 24.h * task.attempt }
    }
}

// Deep runs produce large intermediates; keep the scratch/IO story sane.
executor {
    queueSize       = 8
    submitRateLimit = '10 sec'
}

// Work dirs get very large on deep runs. Left false so -resume works; flip to true
// (or run `nextflow clean -f`) once you're done inspecting a completed run.
cleanup = false
