/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    TaxTriage "light" profile: samplesheet -> (Kraken2 and/or local FASTA) -> alignment
    -> TASS -> report, and nothing else.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use with a container profile, e.g.

      # Kraken2 picks the references (downloaded from NCBI)
      nextflow run main.nf -profile light,docker --input ss.csv --db <k2_db> --outdir out

      # Local FASTA only, no Kraken2
      nextflow run main.nf -profile light,docker --input ss.csv --skip_kraken2 \
          --reference_fasta refs/ --outdir out

      # Both (Kraken2 top hits + your FASTA)
      nextflow run main.nf -profile light,docker --input ss.csv --db <k2_db> \
          --reference_fasta refs/ --outdir out

    For an offline / air-gapped run also pass the inputs that are otherwise downloaded:
      --taxdump <dir with nodes.dmp + names.dmp>   (else DOWNLOAD_TAXDUMP)
      --assembly <assembly_summary_refseq.txt>     (else GET_ASSEMBLIES)
    and, with --skip_kraken2, nothing is fetched from NCBI per sample.

    Every value here is a plain param, so anything can still be turned back on from
    the command line (e.g. `-profile light,docker --genome human` keeps host removal).
    Images for this mode: scripts/image_manifest.sh --mode light-k2 (see --help).
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Light profile'
    config_profile_description = 'Samplesheet check -> classification/local refs -> alignment -> TASS -> report only'

    // ── Read QC / reduction: off ────────────────────────────────────────────
    skip_trimming   = true      // overrides trim=TRUE rows (no TrimGalore / Porechop)
    enable_fastp    = false
    enable_plots    = false     // FastQC / NanoPlot
    downsample      = false     // bbnorm
    subsample       = null      // seqtk

    // ── Classifier side outputs that TASS never reads ───────────────────────
    skip_krona              = true
    skip_kraken_summaries   = true   // MERGEDSUBSPECIES / MERGEDKRAKENREPORT / FILTERKRAKEN
    centrifuge              = false
    metaphlan               = null

    // ── Post-alignment extras: off ──────────────────────────────────────────
    get_variants        = false
    reference_assembly  = null
    use_denovo          = null
    use_diamond         = null
    annotate            = false
    pathogenicity       = false
    novelty             = false
    microbert           = null
    fcs                 = false
    mask_products       = false
    generate_iss        = false
    generate_nanosim    = false

    // ── Reporting: keep TASS + reports, drop the aggregators ────────────────
    alignment_trends    = false
    skip_multiqc        = true
    skip_versions_dump  = true
}
